# ------------------------------------------------------------------------------
# Inrun / Konduktor Core
# ------------------------------------------------------------------------------

# Version and environment
INRUN_ENV=development          # development | staging | production
LOG_LEVEL=""                 # debug | info | warn | error | fatal (default: info)

# ------------------------------------------------------------------------------
# Kubernetes Cluster Configuration
# ------------------------------------------------------------------------------

# Path to kubeconfig
KUBECONFIG=""       # (default: /home/$USER/.kube/config)

# API server override (rarely needed)
MASTER_URL=""

# Cluster identity
CLUSTER_NAME=crd-example-cluster
INRUN_NAMESPACE=""            # Where inrun is deployed

# Workload defaults
DEFAULT_RESYNC=2                   # Seconds; default resync period for all CRDs if not declared per crd
DEFAULT_WORKERS=3                  # Default worker count per CRD if not declared per crd
SHUTDOWN_TIMEOUT=30               # per-CRD worker drain — how long to wait for in-flight reconciles
SHUTDOWN_GRACE_PERIOD=45          # outer safety net — how long before we force-exit regardless
                            # the hard wall that nothing can exceed. 
                            # It should always be larger than SHUTDOWN_TIMEOUT
# ------------------------------------------------------------------------------
# HTTP Server
# ------------------------------------------------------------------------------

HEALTH_PORT=8080             # Port for /health, /ready and /metrics
SRV_READ_TIMEOUT=5           # Seconds
SRV_WRITE_TIMEOUT=20         # Seconds

# ------------------------------------------------------------------------------
# HTTPS Server
# ------------------------------------------------------------------------------
ENABLE_CONVERSION=""          # Default: false
TLS_CERT=""                   # Required if conversion is enabled
TLS_KEY=""                    # Required if conversion is enabled
CONVERSION_WINDOW=""          # Default: 1000

# ------------------------------------------------------------------------------
# Leader Leader Election
# ------------------------------------------------------------------------------

LEASE_DURATION=60            # Seconds; total lease duration
RENEW_DEADLINE=40            # Seconds; must be < LEASE_DURATION
RETRY_PERIOD=10              # Seconds; retry interval for leader election

# ------------------------------------------------------------------------------
# Blueprint / Stack Configuration
# ------------------------------------------------------------------------------

# Paths to Blueprint or Stack files (comma-separated or single path)
# Can be overridden with --file flag
BLUEPRINT_PATH=./blueprint.yaml

# Default queue depth and degrade threshold for CRDs
MAX_QUEUE_DEPTH=100
DEGRADE_THRESHOLD=5
